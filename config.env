# Configuración común de "¿Está apto hoy?"
# Cada módulo lee este archivo. Nunca escriban la IP ni las claves dentro del código.
# Este archivo va en Git con valores de ejemplo y SIN claves. Las claves y los valores de cada laptop (MQTT_PASS,
# MQTT_PASS_LECTURA, la URL de DroidCam...) van en config.local.env, con el mismo formato: no se sube a Git y
# lo que diga ahí reemplaza a lo de este archivo.

# --- Broker MQTT ---
# En casa (desarrollo): localhost, con el Mosquitto de cada uno.
# En el evento: la IP de la laptop de Bri (la ven con ipconfig).
MQTT_HOST=localhost
MQTT_PORT=1883
# Usuario que publica y lee. Déjenlos vacíos si su Mosquitto de desarrollo permite acceso anónimo.
MQTT_USER=
MQTT_PASS=
# Usuario de solo lectura para los paneles abiertos desde OTRA laptop (en el evento: equipo y su clave).
# Desde la laptop de la estación (localhost) los paneles usan MQTT_USER y MQTT_PASS.
MQTT_USER_LECTURA=
MQTT_PASS_LECTURA=
# Puerto WebSocket del broker para los paneles web (listener 9001 de mosquitto.conf).
MQTT_WS_PORT=9001

# --- MongoDB (registrador de mensajes) ---
# Solo en esta laptop: registrador\mongo_local.py arranca el mongod instalado escuchando solo en 127.0.0.1,
# con los datos en datos\mongo. No pongan aquí una IP de la red.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=apto_hoy

# Persona que se evalúa por defecto (minúsculas, sin espacios ni tildes).
PERSONA=bri
# Tripulación, separada por comas. El copiloto la usa para «soy Eric», «habla Sebas» o «aquí Bri».
TRIPULACION=bri,danilo,sebas,eric,adrian

# --- Voz ---
# Índice del micrófono (python voz/voz_fatiga.py --listar). Vacío = micrófono por defecto.
MIC_DISPOSITIVO=
VOZ_SEGUNDOS=12

# --- Visión (python vision/vision.py --listar) ---
# Cámara: índice (0 = la de la laptop, 1, 2...) o la URL de DroidCam, como http://IP:4747/video
# DroidCam: la IP la muestra la app del celular y puede cambiar; pónganla en config.local.env
# (CAMARA=http://IP:4747/video). El celular atiende a un solo programa a la vez (cierren el cliente de Windows y la
# pestaña del navegador). La cámara virtual de DroidCam no sirve: da cuadros vacíos.
# DroidCam por cable USB (no depende del Wi-Fi; Android con depuración USB): CAMARA=http://127.0.0.1:4747/video
# Usa adb (Android SDK Platform-Tools); si no está en el lugar de siempre, pongan su ruta en ADB=...
CAMARA=0
# Si la cámara de CAMARA (el celular) no da video, se mide con la de la laptop: CAMARA_RESPALDO (índice; vacío =
# sin respaldo). Con el celular por cable, antes la visión enciende su pantalla y abre la app DroidCam.
# El resultado dice con cuál se midió («camara») y, si fue la de respaldo, por qué (en «avisos»).
CAMARA_RESPALDO=0
# Video en vivo de la cámara (con la malla de la cara) para el panel de la estación, mientras mide. Solo en
# esta laptop: http://127.0.0.1:PUERTO/video. Si se cambia, reiniciar vision.py y paneles/servidor.py.
VISION_VIDEO_PUERTO=8091
# Duración de una medición con la cámara, en segundos.
VISION_SEGUNDOS=60
# Lentes: antes de medir se pide quitarlos (0 = no revisar). El umbral se ajusta mirando el puntaje en
# python vision/vision.py --ver, con y sin lentes (queda entre los dos). Si no se los quitan en LENTES_ESPERA_S,
# se mide igual y los ojos no cuentan para el semáforo.
LENTES_REVISAR=1
LENTES_UMBRAL=4
LENTES_ESPERA_S=30
# Bostezos tapados con la mano: los ojos cuentan como entrecerrados por debajo de esta fracción del ojo abierto,
# durante al menos BOSTEZO_OJOS_S segundos; la mandíbula, si la cara se alarga esta fracción. Cuando la mano se va
# de la boca, la consola de visión dice qué se midió: con eso se ajustan.
BOSTEZO_OJOS_FRAC=0.85
BOSTEZO_OJOS_S=0.3
BOSTEZO_MANDIBULA=0.08
# Ojos «muy cerrados» (fracción del abierto) durante 1,5 s con la mano en la boca: también cuenta (con la mano
# encima la mandíbula casi no se ve; los pómulos suben y cierran los ojos).
BOSTEZO_OJOS_MUY_FRAC=0.60
# Bostezos con la boca a la vista: además de MAR >= 0,6 durante 1,5 s, necesitan una señal de bostezo (basta una):
# ojos por debajo de BOSTEZO_OJOS_FRAC durante BOSTEZO_VISTO_OJOS_S segundos, boca abierta BOSTEZO_LARGO_S segundos,
# o que se abra de a poco (de MAR 0,3 a 0,6 en BOSTEZO_SUBIDA_S segundos o más). Si no se cuenta un bostezo real,
# miren el motivo con --diagnostico y bajen el que corresponda.
BOSTEZO_VISTO_OJOS_S=0.5
BOSTEZO_LARGO_S=2.5
BOSTEZO_SUBIDA_S=0.4
# 1 = la consola de visión explica también las aperturas de boca descartadas como bostezo (igual que --diagnostico).
VISION_DIAGNOSTICO=0

# --- Copiloto ---
OLLAMA_MODEL=qwen2.5:7b
# Modelo de Whisper: tiny, base, small o medium. small es buen equilibrio en el procesador.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Ruta del modelo de voz de Piper (.onnx). Vacío = usa la voz de Windows (pyttsx3).
PIPER_VOZ=modelos/es_MX-claude-high.onnx
# Velocidad de Piper (length_scale): 1.0 es normal y más alto es más lento. Para comparar las voces
# de modelos/: python herramientas/comparar_voces.py
PIPER_VELOCIDAD=1.1
# Cómo se leen en voz alta algunas palabras. Solo cambia lo que dice la voz: en pantalla y por MQTT
# queda el texto original. Formato: Palabra:como se lee, separados por comas (palabras completas,
# sin importar mayúsculas). Ejemplo: PRONUNCIAR=PVT:pe ve te
PRONUNCIAR=

# --- Paneles web (python paneles/servidor.py, http://localhost:8080) ---
# Duración de la prueba de reacción en segundos (la cámara mide al mismo tiempo): 60 = 1 minuto; 180 = la PVT-B
# de 3 minutos. La casilla «Modo demo» de la estación la baja a 40 s, y la de símbolos de 90 a 40 s.
PVT_SEGUNDOS=60
# (En la rama houston estaba PVT_SEGUNDOS=180, la PVT-B completa; main lo bajó a 60. Para volver: PVT_SEGUNDOS=180)
# Retraso simulado de la comunicación con Tierra en tierra.html, en segundos (acepta decimales). 2.6 s = ida y vuelta
# a la Luna (unos 1,3 s por tramo); a Marte serían de 3 a 22 min por tramo. Antes era 20 s.
RETRASO_TIERRA_S=2.6

# --- Houston: control de misión en Tierra (houston/, con Docker: docker compose up -d --build) ---
# Se suscribe a Mosquitto y guarda en su propio MongoDB (en Docker, el URI lo pone docker-compose.yml).
# La IP de Mosquitto para Docker va en houston/.env: HOUSTON_MQTT_HOST=...
HOUSTON_MONGO_URI=mongodb://localhost:27018
HOUSTON_MONGO_DB=houston
# Retraso de la comunicación nave -> Tierra, en segundos (vacío = RETRASO_TIERRA_S).
HOUSTON_RETRASO_S=
HOUSTON_PUERTO=8090
