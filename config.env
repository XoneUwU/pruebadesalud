# Configuración común de "¿Está apto hoy?"
# Cada módulo lee este archivo. Nunca escriban la IP ni las claves dentro del código.

# --- Broker MQTT ---
# En casa (desarrollo): localhost, con el Mosquitto de cada uno.
# En el evento: la IP de la laptop de Bri (la ven con ipconfig).
MQTT_HOST=localhost
MQTT_PORT=1883
# Usuario que publica y lee. Déjenlos vacíos si su Mosquitto de desarrollo permite acceso anónimo.
MQTT_USER=
MQTT_PASS=
# Usuario de solo lectura para los paneles abiertos desde OTRA laptop (en el evento: equipo y su clave).
# Desde la laptop de la estación (localhost) los paneles usan MQTT_USER y MQTT_PASS.
MQTT_USER_LECTURA=
MQTT_PASS_LECTURA=
# Puerto WebSocket del broker para los paneles web (listener 9001 de mosquitto.conf).
MQTT_WS_PORT=9001

# --- MongoDB (registrador de mensajes) ---
# Solo en esta laptop: registrador\mongo_local.py arranca el mongod instalado escuchando solo en 127.0.0.1,
# con los datos en datos\mongo. No pongan aquí una IP de la red.
MONGO_URI=mongodb://localhost:27017
MONGO_DB=apto_hoy

# Persona que se evalúa por defecto (minúsculas, sin espacios ni tildes).
PERSONA=bri
# Tripulación, separada por comas. El copiloto la usa para «soy Erick», «habla Sebas» o «aquí Bri».
TRIPULACION=bri,danilo,sebas,erick,adrian

# --- Voz ---
# Índice del micrófono (python voz/voz_fatiga.py --listar). Vacío = micrófono por defecto.
MIC_DISPOSITIVO=
VOZ_SEGUNDOS=12

# --- Visión (python vision/vision.py --listar) ---
# Cámara: índice (0 = la de la laptop, 1, 2...) o la URL de DroidCam, como http://IP:4747/video
# DroidCam: la IP la muestra la app del celular y puede cambiar; el celular atiende a un solo programa a la vez
# (cierren el cliente de Windows y la pestaña del navegador). La cámara virtual de DroidCam no sirve: da cuadros vacíos.
CAMARA=http://192.168.26.7:4747/video
# Duración de una medición con la cámara, en segundos.
VISION_SEGUNDOS=60

# --- Copiloto ---
OLLAMA_MODEL=qwen2.5:7b
# Modelo de Whisper: tiny, base, small o medium. small es buen equilibrio en el procesador.
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
# Ruta del modelo de voz de Piper (.onnx). Vacío = usa la voz de Windows (pyttsx3).
PIPER_VOZ=modelos/es_MX-claude-high.onnx
# Velocidad de Piper (length_scale): 1.0 es normal y más alto es más lento. Para comparar las voces
# de modelos/: python herramientas/comparar_voces.py
PIPER_VELOCIDAD=1.1
# Cómo se leen en voz alta algunas palabras. Solo cambia lo que dice la voz: en pantalla y por MQTT
# queda el texto original. Formato: Palabra:como se lee, separados por comas (palabras completas,
# sin importar mayúsculas). Ejemplo: PRONUNCIAR=PVT:pe ve te
PRONUNCIAR=

# --- Paneles web (python paneles/servidor.py, http://localhost:8080) ---
# Duración de la prueba de reacción en segundos: 180 es la PVT-B de 3 minutos; 60 para demos.
PVT_SEGUNDOS=180
# Retraso simulado de la comunicación con Tierra en tierra.html, en segundos (el real a Marte: 3 a 22 min).
RETRASO_TIERRA_S=20
